@inject IGeocodingService GeocodingService
@inject ILogger<DestinationSearch> Logger
@inject NavigationManager Navigation

<div class="search-panel">
    <div class="search-bar">
        <div class="input-with-icon">
            <i class="bi bi-geo-alt" aria-hidden="true"></i>
            <input id="city-search" class="form-control form-control-lg" aria-label="City name" placeholder="Search a city, e.g. Lisbon, Kraków, Budapest"
                   @bind="searchText" @bind:event="oninput" @onkeydown="HandleKeyDown" />
        </div>
        <button class="btn btn-primary btn-lg" @onclick="SearchAsync" disabled="@isLoading">
            <i class="bi bi-search" aria-hidden="true"></i> Search
        </button>
    </div>
</div>

<section class="results">
    @if (isLoading)
    {
        <div class="status-message">
            <div class="spinner-border text-secondary" role="status"></div>
            <span>Looking for "@lastSearch"...</span>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-warning">@errorMessage</div>
    }
    else if (hasSearched && results.Count == 0)
    {
        <div class="status-message">No cities found for "@lastSearch". Check the spelling or try a bigger city nearby.</div>
    }
    else if (results.Count > 0)
    {
        <h2 class="section-title">Results for "@lastSearch"</h2>
        <p class="section-subtitle">@results.Count place(s) found - choose one to see its plan.</p>

        <div class="results-grid">
            @foreach (Destination destination in results)
            {
                <button type="button" class="destination-card" @onclick="() => OpenPlan(destination)">
                    @if (!string.IsNullOrEmpty(destination.FlagUrl))
                    {
                        <img src="@destination.FlagUrl" alt="Flag of @destination.Country" class="flag" />
                    }
                    <span class="card-text">
                        <span class="city">@destination.Name</span>
                        <span class="details">@(string.IsNullOrEmpty(destination.Region) ? destination.Country : $"{destination.Region}, {destination.Country}")</span>
                    </span>
                    <i class="bi bi-chevron-right chevron" aria-hidden="true"></i>
                </button>
            }
        </div>
    }
</section>

@code {
    
    private string searchText = string.Empty;
    private string lastSearch = string.Empty;
    private List<Destination> results = new List<Destination>();
    private bool isLoading = false;
    private bool hasSearched = false;
    private string? errorMessage;

    
    private async Task SearchAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(searchText) || searchText.Trim().Length < 2)
        {
            errorMessage = "Please type at least 2 letters of a city name.";
            return;
        }

        isLoading = true;
        lastSearch = searchText.Trim();

        try
        {
            results = await GeocodingService.SearchCitiesAsync(lastSearch);
        }
        catch (ApiException ex)
        {
            
            errorMessage = "Sorry, the city search isn't available right now. Please try again in a moment.";
            Logger.LogWarning(ex, "City search failed for {City}", lastSearch);
            results = new List<Destination>();
        }
        finally
        {
            
            isLoading = false;
            hasSearched = true;
        }
    }

    private void OpenPlan(Destination destination)
    {
       
        Navigation.NavigateTo(destination.ToPlanUrl());
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
      
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }
}